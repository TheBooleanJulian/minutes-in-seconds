# Copy to deploy/vm/.env on the VM (never commit it).

# Cloudflare Tunnel token: Zero Trust → Networks → Tunnels → Create → Cloudflared → copy the token from the
# install command. Public hostname: minutes-in-seconds.thebooleanjulian.dev → http://app:8080
TUNNEL_TOKEN=

# Speaker diarization (optional). Same value as the Zeabur service.
HF_TOKEN=

# AI cleanup + summary (optional). Same value as the Zeabur service.
ANTHROPIC_API_KEY=
